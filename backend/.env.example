SANE_APP_NAME=SANE API
SANE_DEBUG=true
SANE_API_PREFIX=/api
# Optional override. Leave unset to use the backend-local SQLite ALPHA default.
# SQLite example:
# SANE_DATABASE_URL=sqlite:///D:/path/to/sane_alpha.db
# PostgreSQL example:
# SANE_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@localhost:5432/sane

SANE_CORS_ORIGINS=["http://localhost:5173"]
SANE_LOCAL_USER_EMAIL=local-alpha@sane.local
SANE_LOCAL_USER_DISPLAY_NAME=Local ALPHA User