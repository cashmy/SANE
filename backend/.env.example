SANE_APP_NAME=SANE API
SANE_DEBUG=true
SANE_AUTH_MODE=google_oauth
SANE_API_PREFIX=/api
# Required runtime database configuration.
SANE_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/sane

# Required backend test database. It must already exist, differ from the runtime
# database, and use a database name that includes "test".
SANE_TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/sane_test

SANE_CORS_ORIGINS=["http://localhost:5173"]
SANE_LOCAL_USER_EMAIL=local-alpha@sane.local
SANE_LOCAL_USER_DISPLAY_NAME=Local ALPHA User
SANE_FRONTEND_URL=http://localhost:5173
SANE_JWT_SECRET=CHANGE_ME_FOR_LOCAL_USE_ONLY
## For local UI/workflow review without Google OAuth, switch auth mode to
## local_dev while keeping SANE_DEBUG=true. This creates only the Local ALPHA
## app session and does not connect Gmail or trigger ingestion.
SANE_CREDENTIAL_ENCRYPTION_KEY=GENERATE_A_LOCAL_FERNET_KEY
SANE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
SANE_GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
SANE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
SANE_GMAIL_REDIRECT_URI=http://localhost:8000/api/gmail/callback